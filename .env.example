# 默认使用本机 Ollama。qwen3.5:0.8b 支持文本和图像输入；模型不可用时服务会降级为内置教学回复。
PORT=8788
DATABASE_URL=postgres://agent:agent_dev_password@127.0.0.1:5432/agent_platform
JWT_SECRET=replace-with-a-long-random-secret
ACCESS_TOKEN_TTL=30m
REFRESH_TOKEN_TTL_DAYS=14
ENABLE_DEMO_LOGIN=true
DEMO_USER_EMAIL=demo@agent-workbench.local
DEMO_USER_PASSWORD=Demo123456!
LLM_PROVIDER=ollama
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen3.5:0.8b
OLLAMA_TOOL_MODEL=local-qwen35b-tools:latest
EMBEDDING_MODEL=nomic-embed-text:latest
MODEL_TIMEOUT_MS=60000
AGENT_MAX_STEPS=4
TOOL_TIMEOUT_MS=5000
TOOL_RETRY_COUNT=1
WEB_SEARCH_PROVIDER=searxng
SEARXNG_BASE_URL=http://127.0.0.1:8081
WEB_SEARCH_TIMEOUT_MS=10000
SANDBOX_BASE_URL=http://127.0.0.1:8790
# 本地开发可用任意长随机字符串；生产环境请使用密钥管理服务注入。
SANDBOX_RUNNER_TOKEN=replace-with-a-long-random-value
SANDBOX_TIMEOUT_MS=3000
ARTIFACT_DIR=./artifacts
ARTIFACT_LINK_TTL_SECONDS=900
TRACE_RETENTION=200
REDIS_URL=redis://127.0.0.1:6379
REDIS_KEY_PREFIX=agent-workbench:
MINIO_ENDPOINT=http://127.0.0.1:9000
MINIO_ACCESS_KEY=agent-minio
MINIO_SECRET_KEY=agent-minio-password
MINIO_BUCKET=agent-knowledge

# 切到 OpenAI 或其他 OpenAI 兼容服务时启用。
# LLM_PROVIDER=openai-compatible
# OPENAI_BASE_URL=https://api.openai.com/v1
# OPENAI_API_KEY=your_api_key
# OPENAI_MODEL=gpt-4.1-mini
